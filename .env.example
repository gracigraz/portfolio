# Copy to .env.local and fill in. Never commit real values.

# Resend API key with "Sending access" (resend.com > API Keys)
RESEND_API_KEY=

# Where contact messages are delivered. Must be your Resend account email
# while sending from onboarding@resend.dev.
CONTACT_TO_EMAIL=

# Supabase project URL (Project Settings > API)
SUPABASE_URL=

# Supabase secret key, starts with sb_secret_ (Project Settings > API Keys).
# Server-only: bypasses row-level security, never expose to the browser.
SUPABASE_SECRET_KEY=
